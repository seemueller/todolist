{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TodoList",
  "version": "0.5.0",
  "identifier": "com.roomote.todolist",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TodoList",
        "width": 480,
        "height": 720,
        "decorations": false,
        "transparent": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' tauri: tauri://*; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "de-DE"
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGRjMxQjZFMzlCMkE2M0QKUldSZFZjWk9oRm5Jd1Z4cHdOdlUyTlFYYmJkS2k3TjlXaFJ5UjdXZG5YV1R1M2FjRjFkMmMK",
      "enduserLicenseAgreement": true,
      "dialog": true
    }
  }
}
